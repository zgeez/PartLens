# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Local inference uses no API credits and never falls back to a cloud provider.
PARTLENS_LLM_PROVIDER=ollama
PARTLENS_LOCAL_URL=http://127.0.0.1:11434
PARTLENS_LOCAL_MODEL=qwen3.5:9b
# 65536 tested on the owner's 16 GB GPU; lower for constrained machines.
PARTLENS_LOCAL_CONTEXT=65536
PARTLENS_LOCAL_TIMEOUT=180
# Explicitly select anthropic only after credits are available.
PARTLENS_ALLOW_PAID_INFERENCE=disabled
# Owner-only opt-in after explicit authorization: owner_authorized
ANTHROPIC_API_KEY=
PARTLENS_ANTHROPIC_MODEL=claude-sonnet-5-5
# Keep disabled for baseline tests. Opt-in outside baseline: default
PARTLENS_MODEL_FALLBACK=disabled
# Explicit local transport selection. native preserves the original tool protocol;
# json-schema uses Ollama format=JSON-schema, with the same controller/checks. No automatic fallback.
PARTLENS_LOCAL_PROTOCOL=native
NVIDIA_API_KEY=
PARTLENS_NVIDIA_MODEL=

# Zetaris SQL UI gateway origin, e.g. http://localhost:3000 (not :8888/api/v1.0).
# Names and route follow the official Zetaris getting-started helper.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_ENGINE_ID=
# Set after registering the approved demo, e.g. PARTLENS_EASYDUINO_<run>.parts
PARTLENS_ZETARIS_PARTS_TABLE=

# Official Mouser Search API (read-only; obtain a key through the owner's account)
MOUSER_API_KEY=

# Official JLCPCB public-component lookup only. APP_NAME is optional metadata, not a signing input.
JLC_APP_ID=
JLC_ACCESS_KEY=
JLC_SECRET_KEY=
JLC_APP_NAME=
# Set to jlcpcb only when the selected Zetaris table holds official jlcpcb rows; default lcsc.
PARTLENS_ZETARIS_BOM_SUPPLIER=lcsc
